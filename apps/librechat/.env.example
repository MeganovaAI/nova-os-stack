# LibreChat secrets — required.
# Copy to apps/librechat/.env and fill in real values. The compose file is
# fail-fast: leaving any of these blank makes `docker compose up` error out
# with the matching hint.

# Nova OS API key — issue one in the Nova OS dashboard, Settings → API Keys.
NOVA_OS_API_KEY=

# Random 32-byte hex strings. Generate each with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENID_SESSION_SECRET=

# OIDC client secret — register a client called "librechat" in Nova OS
# (Settings → OIDC), copy the secret it generates, paste here.
NOVA_OS_OIDC_CLIENT_SECRET=

# Optional overrides
# LIBRECHAT_PORT=3080
# LIBRECHAT_PUBLIC_URL=https://chat.your-company.example
# APP_TITLE=Nova OS Chat
# ALLOW_REGISTRATION=true
# CONCURRENT_MESSAGE_MAX=5
# NODE_TLS_REJECT_UNAUTHORIZED=0   # set to 1 once Nova OS has a real TLS cert
