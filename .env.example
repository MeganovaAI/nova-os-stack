# Nova OS Stack — environment configuration
#
# Copy this file to .env and fill in real values. The compose file uses the
# `${VAR:?required - <hint>}` pattern, so leaving a required value blank will
# cause `docker compose up` to fail with a clear error message.

# ──────────────────────────────────────────────────────────────────────────
# Nova OS image
# ──────────────────────────────────────────────────────────────────────────

# Pin to a specific tag in production. `latest` skips release candidates.
# See https://github.com/orgs/MeganovaAI/packages/container/package/nova-os
NOVA_OS_VERSION=latest

# Public URL the Nova OS UI is reachable at. Used as the OIDC issuer and in
# server-issued links. Must match how end-users actually reach the server.
# Example: https://nova-os.your-company.example
NOVA_OS_PUBLIC_URL=http://localhost:8900

# ──────────────────────────────────────────────────────────────────────────
# Initial admin (created on first boot)
# ──────────────────────────────────────────────────────────────────────────

NOVA_OS_ADMIN_EMAIL=
NOVA_OS_ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Postgres (state for users, agents, jobs, settings)
# ──────────────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# LLM provider keys — set at least one
# ──────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: route Anthropic / OpenAI requests through MegaNova's gateway for
# multi-provider fallback and unified billing.
# MEGANOVA_API_KEY=
# MEGANOVA_BASE_URL=https://api.meganova.ai

# ──────────────────────────────────────────────────────────────────────────
# Optional companion-app wiring (only needed if the app is running)
# ──────────────────────────────────────────────────────────────────────────

# SearXNG meta-search (apps/searxng)
# SEARXNG_URL=http://searxng:8080

# crawl4ai page fetcher (apps/crawl4ai)
# CRAWL4AI_URL=http://crawl4ai:11235

# Firecrawl page fetcher (apps/firecrawl)
# FIRECRAWL_URL=http://firecrawl-api:3002

# Docling document parser (apps/docling)
# DOCLING_URL=http://docling:5001

# FlashRank reranker (apps/flashrank)
# FLASHRANK_URL=http://flashrank:8000

# Phoenix observability (apps/phoenix)
# OTEL_EXPORTER_OTLP_ENDPOINT=phoenix:4317
