# Nova OS Stack — environment configuration
#
# Copy this file to .env and fill in real values. The compose file uses the
# `${VAR:?required - <hint>}` pattern, so leaving a required value blank will
# cause `docker compose up` to fail with a clear error message.

# ──────────────────────────────────────────────────────────────────────────
# Nova OS image
# ──────────────────────────────────────────────────────────────────────────

# Pin to a specific tag in production. The stack repo is tested against
# the version below; bumping to `latest` may pull a newer image that has
# config or behavior changes not reflected here.
# See https://github.com/orgs/MeganovaAI/packages/container/package/nova-os
NOVA_OS_VERSION=v0.1.7

# Public URL the Nova OS UI is reachable at. Used as the OIDC issuer and in
# server-issued links. Must match how end-users actually reach the server.
# Example: https://nova-os.your-company.example
NOVA_OS_PUBLIC_URL=http://localhost:8900

# ──────────────────────────────────────────────────────────────────────────
# Required secrets
# ──────────────────────────────────────────────────────────────────────────

# Initial admin (created on first boot).
NOVA_OS_ADMIN_EMAIL=
NOVA_OS_ADMIN_PASSWORD=

# JWT signing secret. REQUIRED — the server refuses to start without it.
# Generate with: openssl rand -hex 32
NOVA_OS_JWT_SECRET=

# Postgres password (state for users, agents, jobs, settings, installed apps).
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Apps directory (multi-app primitive, v0.1.7+)
# ──────────────────────────────────────────────────────────────────────────

# Where installed app manifest dirs live. The compose file mounts a named
# volume here so apps installed via `nova-os apps install <name>` or
# `/admin/apps.html` survive container restarts. Without the volume mount,
# installed apps disappear on every `docker compose down/up`.
NOVA_OS_APPS_ROOT=/var/nova-os/apps

# ──────────────────────────────────────────────────────────────────────────
# Connector OAuth (Slack, future integrations)
# ──────────────────────────────────────────────────────────────────────────

# AES-256 key for encrypting connector OAuth tokens at rest. When unset,
# the connector endpoints are silently disabled. Generate with:
#   openssl rand -hex 32
# (must be exactly 64 hex chars = 32 bytes)
NOVA_OS_INTEGRATION_KEY=

# ──────────────────────────────────────────────────────────────────────────
# LLM provider keys — set at least one
# ──────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: route LLM requests through MegaNova's gateway for multi-provider
# fallback and unified billing. MEGANOVA_API_KEY is accepted as a deprecated
# alias of MEGANOVA_CLOUD_KEY for backward compatibility.
# MEGANOVA_CLOUD_KEY=
# MEGANOVA_CLOUD_URL=https://api.meganova.ai

# Optional override of the default chat model when using the MegaNova gateway.
# Every gateway-bound model name must carry a `<provider>/` prefix:
#   anthropic/claude-opus-4-7, openai/gpt-5, gemini/gemini-2.5-flash, ...
# Pull the canonical list from GET https://api.meganova.ai/models
# OPENAI_API_BASE=https://api.meganova.ai
# OPENAI_MODEL=gemini/gemini-2.5-flash

# ──────────────────────────────────────────────────────────────────────────
# Optional companion-app wiring (only needed if the app is running)
# ──────────────────────────────────────────────────────────────────────────

# SearXNG meta-search (apps/searxng)
# SEARXNG_URL=http://searxng:8080

# crawl4ai page fetcher (apps/crawl4ai)
# CRAWL4AI_URL=http://crawl4ai:11235

# Docling document parser (apps/docling)
# DOCLING_URL=http://docling:5001
