# Partner TLS-Terminated Template — environment configuration
#
# Copy to .env and fill in real values. TLS terminates upstream of this
# compose (Cloudflare / ALB / Caddy / corporate LB) — no cert files
# managed here.

# ───────── Nova OS image ─────────
NOVA_OS_VERSION=v0.1.8

# ───────── Public-facing config ─────────
# The HTTPS URL the partner's reverse proxy advertises. Nova OS uses
# this as the OIDC issuer and in server-issued links — must be the URL
# end-users actually reach the system at, NOT the internal proxy target.
#
# Critical: if this drifts from what the proxy serves, OIDC fails
# (nova-os#521) and bench routing breaks (#244).
NOVA_OS_PUBLIC_URL=https://nova.partner.example.com

# Internal-network host:port the partner's proxy reaches nova-os at.
# Bind to a specific interface (NOT 0.0.0.0) if the host has both
# public and private NICs and you want to restrict access.
NOVA_OS_BIND=0.0.0.0
NOVA_OS_INTERNAL_PORT=8900
LIBRECHAT_INTERNAL_PORT=3080

# ───────── Auth — REQUIRED ─────────
NOVA_OS_JWT_SECRET=
NOVA_OS_ADMIN_EMAIL=
NOVA_OS_ADMIN_PASSWORD=

# ───────── Database ─────────
POSTGRES_PASSWORD=

# ───────── LLM provider ─────────
OPENAI_API_BASE=https://api.meganova.ai
OPENAI_API_KEY=
OPENAI_MODEL=gemini/gemini-3.5-flash

# ───────── LibreChat companion ─────────
LIBRECHAT_VERSION=nova-os
NOVA_OS_OIDC_CLIENT_SECRET=
OPENID_SESSION_SECRET=

APP_TITLE=Nova OS
