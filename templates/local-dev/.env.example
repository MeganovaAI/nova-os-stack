# Local Dev Template — environment configuration
#
# Copy to .env and fill in the LLM key at minimum. All other values can
# stay as-is for laptop/single-host development.
#
# Pre-baked dev defaults are NOT secure for production. Switch to the
# single-host-prod template before exposing this to anyone but yourself.

# ───────── Nova OS image ─────────
# Pin to a known-good tag. `latest` may surprise you with config changes.
NOVA_OS_VERSION=v0.1.8

# Public URL — for this template the browser, the LibreChat container,
# and nova-os itself all see the dev host as localhost / host.docker.internal.
# Keep the value as-is unless you know what you're doing.
NOVA_OS_PUBLIC_URL=http://host.docker.internal:8900

# ───────── Auth ─────────
# Required even in local dev — security_guard refuses to boot without them.
# These are fine for a single-developer laptop but DO NOT ship to prod.
NOVA_OS_ADMIN_EMAIL=admin@localhost
NOVA_OS_ADMIN_PASSWORD=dev-password-change-me
NOVA_OS_JWT_SECRET=local-dev-jwt-secret-replace-in-prod

# Postgres password (internal only, but still required).
POSTGRES_PASSWORD=local-dev-pg-password

# ───────── LLM provider — fill in ONE ─────────
# Meganova gateway (recommended — covers 99 models):
OPENAI_API_BASE=https://api.meganova.ai
OPENAI_API_KEY=
OPENAI_MODEL=gemini/gemini-3.5-flash

# OR Anthropic direct:
ANTHROPIC_API_KEY=

# OR Google direct:
GOOGLE_API_KEY=

# ───────── LibreChat companion ─────────
LIBRECHAT_VERSION=nova-os
NOVA_OS_LIBRECHAT_URL=http://localhost:3080
