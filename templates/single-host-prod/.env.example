# Single-Host Prod Template — environment configuration
#
# Copy to .env, fill in REAL values. Compose refuses to start with
# unset required values. Don't ship this with the example placeholders.

# ───────── Nova OS image ─────────
NOVA_OS_VERSION=v0.1.8

# ───────── Public-facing config ─────────
# Hostname end-users (and their browsers) reach this deployment at.
# Must have:
#   - DNS pointing at this host's public IP
#   - A valid TLS cert at certs/fullchain.pem + certs/privkey.pem
#
# This URL is the OIDC issuer, the LibreChat redirect base, and what
# appears in server-issued links. Every consumer must use exactly this
# URL — drift causes OIDC strategy registration failures (see nova-os#521).
NOVA_OS_PUBLIC_URL=https://nova.partner.com

# TLS cert paths inside the nginx container (mapped from certs/).
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# ───────── Auth — REQUIRED ─────────
# Generate with: openssl rand -base64 48
NOVA_OS_JWT_SECRET=
# Initial admin email (used to seed the admin account on first boot).
NOVA_OS_ADMIN_EMAIL=
# Initial admin password (>= 12 chars; rotate on first login).
NOVA_OS_ADMIN_PASSWORD=

# ───────── Database ─────────
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# ───────── LLM provider ─────────
# Meganova gateway recommended (covers 99 models including the
# pinned three-tier defaults for brain/skill/synthesis).
OPENAI_API_BASE=https://api.meganova.ai
OPENAI_API_KEY=
OPENAI_MODEL=gemini/gemini-3.5-flash

# Optional secondary providers (only set if you bypass the gateway):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ───────── LibreChat companion ─────────
LIBRECHAT_VERSION=nova-os
# OIDC client secret shared between nova-os and the LibreChat container.
# Generate with: openssl rand -hex 32
NOVA_OS_OIDC_CLIENT_SECRET=

# Session secret for LibreChat's own session middleware.
# Generate with: openssl rand -base64 48
OPENID_SESSION_SECRET=

# ───────── App branding (optional) ─────────
APP_TITLE=Nova OS
