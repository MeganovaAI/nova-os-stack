# Copy to .env.eval and fill in real values before running:
#   cp .env.eval.example .env.eval
#   docker compose -f docker-compose.eval.yaml --env-file .env.eval up -d

EVAL_PG_PASSWORD=change-me-eval-pg-password
EVAL_JWT_SECRET=change-me-eval-jwt-secret-32-bytes-min
EVAL_ADMIN_EMAIL=admin@example.com
EVAL_ADMIN_PASSWORD=change-me-eval-admin-pw-12-chars-min

# Eval gateway key — use a LOW-LIMIT prepaid key. A runaway simulate loop
# cannot bankrupt you if the gateway has a $X/day cap.
EVAL_OPENAI_API_KEY=sk-eval-...

# Optional model overrides (defaults are cost-efficient choices)
# EVAL_OPENAI_MODEL=anthropic/claude-haiku-4-5
# EVAL_NOVA_OS_BRAIN_MODEL=gemini/gemini-2.5-flash
# EVAL_NOVA_OS_SKILL_MODEL=gemini/gemini-2.5-flash
